# Development only. Generate a fresh SECRET_KEY for any deployment.
SECRET_KEY=your-development-key-change-before-deploying
DB_NAME=ai_recruitment_system
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TOKEN_TTL_SECONDS=28800
CV_RETENTION_DAYS=180
# External processing is opt-in. Set current provider model identifiers explicitly.
USE_GROQ_AI=false
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
USE_GEMINI_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=
USE_LLM_FOR_SCORING=false
LLM_SCORE_WEIGHT=0.25
AI_REQUEST_TIMEOUT=30
SKILL_WEIGHT=0.5
EXPERIENCE_WEIGHT=0.3
EDUCATION_WEIGHT=0.2
# Production additionally requires DJANGO_SETTINGS_MODULE=config.settings.production
# and DATABASE_URL, a generated SECRET_KEY, real ALLOWED_HOSTS and HTTPS origins.
